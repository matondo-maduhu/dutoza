{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.md"
    ],
    "rewrites": [
      { "source": "/login", "destination": "/auth/login.html" },
      { "source": "/register", "destination": "/auth/register.html" },
      { "source": "/forgot-password", "destination": "/auth/forgot_password.html" },
      { "source": "/feed", "destination": "/feed/feed.html" },
      { "source": "/", "destination": "/index.html" }
    ]
  }
}
